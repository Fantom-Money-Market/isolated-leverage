# forge install deps are gitignored, but forge-std is a proper
# git submodule (.gitmodules) and must stay visible to git.
lib/*
!lib/forge-std
# Foundry deploy/broadcast logs — can embed RPC URLs & tx metadata.
broadcast/
# Gas snapshots are fine to track; ignore only the diff temp files.
.gas-snapshot-diff

# ============================================================
# Local fork UI (not part of the repo)
# ============================================================
/fork-ui/

# ============================================================
# Deployments / upgrade plugins (if added later)
# ============================================================
deployments/localhost/
deployments/hardhat/
.openzeppelin/unknown-*.json

